<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.65535</FileVersion>
    <!-- Existing public updaters validate the stable bootstrap as core.0.
         Payload revisions remain monotonic beyond every beta revision. -->
    <InstallerFileVersion>1.2.0.0</InstallerFileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>The Order</Product>
    <Authors>The Order contributors</Authors>
    <Copyright>Copyright © 2026 The Order contributors</Copyright>
  </PropertyGroup>
</Project>
