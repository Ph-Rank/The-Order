<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.2.2-beta.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <!-- Published clients validate both Setup and the installed payload as core.beta.
         SemVer orders stable after beta; manifest hashes drive file replacement. -->
    <FileVersion>1.2.2.2</FileVersion>
    <InformationalVersion>1.2.2-beta.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>The Order</Product>
    <Authors>The Order contributors</Authors>
    <Copyright>Copyright © 2026 The Order contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- Playnite 10 requires LiteDB v4 on disk. The interchange adapter exclusively
         reads raw BsonDocument values; it never uses POCO/object deserialization,
         rejects _type recursively, and writes only application-generated documents.
         GHSA-3x49-g6rc-c284's BsonMapper type-activation path is unreachable.
         See docs/manager-interchange.md; do not use LiteDB outside this boundary. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-3x49-g6rc-c284" />
  </ItemGroup>
</Project>
