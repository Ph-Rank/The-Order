<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.2.1-beta.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <!-- Published clients validate both Setup and the installed payload as core.beta.
         SemVer orders stable after beta; manifest hashes drive file replacement. -->
    <FileVersion>1.2.1.1</FileVersion>
    <InformationalVersion>1.2.1-beta.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>The Order</Product>
    <Authors>The Order contributors</Authors>
    <Copyright>Copyright © 2026 The Order contributors</Copyright>
  </PropertyGroup>
</Project>
