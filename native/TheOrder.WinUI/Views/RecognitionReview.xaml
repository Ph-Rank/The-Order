<?xml version="1.0" encoding="utf-8"?><UserControl x:Class="TheOrder.WinUI.Views.RecognitionReview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:TheOrder.Presentation" xmlns:a="using:TheOrder.Application" xmlns:local="using:TheOrder.WinUI.Views" xmlns:l="using:TheOrder.WinUI.Localization">
<Border Style="{StaticResource SurfaceStyle}" Padding="20">
 <StackPanel Spacing="16">
     <TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="识别核对" />
     <TextBlock Text="{x:Bind ViewModel.SelectedMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionSelectedState" AutomationProperties.LiveSetting="Polite" />
     <Expander HorizontalAlignment="Stretch" l:Localize.Header="识别依据与本地线索"><TextBlock Text="{x:Bind ViewModel.LocalFacts, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RecognitionLocalFacts" /></Expander>
     <local:TagFlowPanel x:Name="ReviewActions" HorizontalSpacing="8" VerticalSpacing="8" MaximumItemWidth="360">
      <Button Click="OnRerun" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRerun" l:Localize.Content="重新识别" /><Button x:Name="IgnoreReviewButton" Click="OnIgnore" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionIgnore" l:Localize.Content="忽略本次建议" />
     </local:TagFlowPanel>
     <ListView x:Name="CandidateList" MaxHeight="420" ScrollViewer.IsVerticalScrollChainingEnabled="True" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCandidateItem, Mode=OneWay}" SelectionMode="Single" SelectionChanged="OnCandidate" AutomationProperties.AutomationId="RecognitionCandidates" l:Localize.Name="待核对的目录作品候选">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate x:DataType="p:RecognitionCandidateCard"><StackPanel Padding="12" Spacing="8"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource CardTitleStyle}" TextAlignment="Left" /><TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Evidence}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Text="{x:Bind Conflicts}" Visibility="{x:Bind local:LibraryFormat.ShowText(Conflicts)}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Foreground="{ThemeResource WarningTextBrush}" /><TextBlock Text="{x:Bind Id}" Style="{StaticResource SecondaryTextStyle}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Tag="{x:Bind Id}" Click="OnRemoteDetails" l:Localize.Content="查看候选详情" /><Button Tag="{x:Bind Id}" Click="OnManualCandidate" Content="关联此作品" /></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Button Click="OnApply" IsEnabled="{x:Bind ViewModel.CanConfirmSelection, Mode=OneWay}" Content="{x:Bind ViewModel.ConfirmSelectionText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RecognitionApply" />
     <Grid x:Name="ManualActions" ColumnSpacing="8" RowSpacing="8" MaxWidth="520" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBox x:Name="ManualIdBox" MinWidth="220" Text="{x:Bind ViewModel.ManualId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" AutomationProperties.AutomationId="RecognitionManualId" Header="手动关联 · 目录作品编号或 KunGal 链接" PlaceholderText="粘贴作品链接，或输入目录编号" l:Localize.Name="手动关联的目录作品编号" /><Button x:Name="ManualApplyButton" Grid.Column="1" VerticalAlignment="Bottom" Click="OnManual" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionManualApply" l:Localize.Content="确认手动关联" />
     </Grid>
     <Button Content="保存为待核验选择" Click="OnSavePending" IsEnabled="{x:Bind ViewModel.CanSaveManualPending, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionSavePending" HorizontalAlignment="Left" />
     <ItemsControl ItemsSource="{x:Bind ViewModel.ManualPendingChoices, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="a:MediaUserLink"><StackPanel Spacing="6"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" /><TextBlock Text="待核验 · 不融合资料" Style="{StaticResource SecondaryTextStyle}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="重试查看" Tag="{x:Bind}" Click="OnOpenPending" /><Button Content="移除选择" Tag="{x:Bind}" Click="OnRemovePending" /></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Width="140" Height="190" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" HorizontalAlignment="Left" Visibility="{x:Bind ShowText(ViewModel.RemoteCoverKey), Mode=OneWay}">
      <local:CoverPresenter SourceKey="{x:Bind ViewModel.RemoteCoverKey, Mode=OneWay}" Width="140" Height="190" ImageCornerRadius="7" HorizontalAlignment="Left" />
     </Border>
      <local:MarkdownView x:Name="RemoteRichFacts" Text="{x:Bind ViewModel.RemoteFacts, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRemoteFacts" />
     <ItemsControl ItemsSource="{x:Bind ViewModel.RemoteLinks, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRemoteLinks">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="p:CandidateDetailLink"><StackPanel Spacing="4"><HyperlinkButton Content="{x:Bind Title}" Tag="{x:Bind Url}" Click="OnOpenLink" HorizontalAlignment="Left" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
</Border>
</UserControl>
