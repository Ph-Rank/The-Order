    <FontFamily x:Key="PGFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="PGIconFontFamily">Segoe Fluent Icons</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
