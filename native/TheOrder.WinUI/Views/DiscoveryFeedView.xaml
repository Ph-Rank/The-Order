<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TheOrder.WinUI.Views.DiscoveryFeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:TheOrder.Presentation"
             xmlns:local="using:TheOrder.WinUI.Views"
             xmlns:l="using:TheOrder.WinUI.Localization">
 <UserControl.Resources>
  <Style x:Key="FeedRow" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="CalendarRow" TargetType="ListViewItem" BasedOn="{StaticResource FeedRow}">
   <Setter Property="IsTabStop" Value="False" />
   <Setter Property="UseSystemFocusVisuals" Value="False" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListViewItem">
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="Stretch" />
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CalendarDayButton" TargetType="ToggleButton">
   <Setter Property="HorizontalAlignment" Value="Stretch" />
   <Setter Property="VerticalAlignment" Value="Stretch" />
   <Setter Property="Padding" Value="0" />
   <Setter Property="MinWidth" Value="0" />
   <Setter Property="MinHeight" Value="0" />
   <Setter Property="CornerRadius" Value="4.5" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="CalendarDayFrame" TargetType="Border">
   <Setter Property="UseLayoutRounding" Value="False" />
   <Setter Property="CornerRadius" Value="5" />
   <Setter Property="BorderBrush" Value="{ThemeResource CalendarDayStroke}" />
   <Setter Property="BorderThickness" Value="0.5" />
  </Style>
  <Style x:Key="CalendarTodayFrame" TargetType="Border" BasedOn="{StaticResource CalendarDayFrame}">
   <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
  </Style>
  <Style x:Key="CalendarReleaseBadge" TargetType="Border">
   <Setter Property="HorizontalAlignment" Value="Right" />
   <Setter Property="VerticalAlignment" Value="Top" />
   <Setter Property="UseLayoutRounding" Value="False" />
   <Setter Property="Padding" Value="1,0" />
   <Setter Property="Background" Value="{ThemeResource CalendarReleaseBadgeFill}" />
   <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  </Style>
  <Style x:Key="CalendarReleaseBadgeText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{ThemeResource CalendarReleaseBadgeInk}" />
   <Setter Property="FontSize" Value="8" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="TextAlignment" Value="Center" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <x:Double x:Key="CalendarCardSpacing">10</x:Double>
  <local:CalendarCardMetrics x:Key="CalendarCardMetrics" />
  <DataTemplate x:Key="CalendarTemplate">
   <StackPanel Margin="2,0,6,12" Spacing="8">
    <Grid Visibility="{Binding HeadingVisibility}" ColumnSpacing="10" Margin="0,4,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold"
                AutomationProperties.HeadingLevel="Level2" />
     <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerBrush}" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Works}">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource CalendarCardSpacing}" /></ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Button Style="{StaticResource SubtleButtonStyle}" Width="{Binding Width, Source={StaticResource CalendarCardMetrics}}"
               Padding="0" CornerRadius="8"
               HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
               Tag="{Binding Id}" Click="OnCalendarWork" AutomationProperties.Name="{Binding AccessibleName}"
               ToolTipService.ToolTip="{Binding AccessibleName}">
        <StackPanel Spacing="8">
         <Border Height="{Binding CoverHeight, Source={StaticResource CalendarCardMetrics}}" CornerRadius="8"
                 Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                 BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1">
          <local:CoverPresenter SourceKey="{Binding ImageKey}" ImageCornerRadius="7"
                                AutomationProperties.AccessibilityView="Raw" />
         </Border>
         <TextBlock Text="{Binding Title}" MinHeight="40" FontSize="15" TextAlignment="Center"
                    Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" MaxLines="2"
                    TextTrimming="CharacterEllipsis" />
        </StackPanel>
       </Button>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="RankingTemplate" x:DataType="p:DiscoveryRow">
   <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
           Padding="0,11" Margin="4,0,9,0" AutomationProperties.Name="{x:Bind AccessibleName}">
    <Grid ColumnSpacing="10">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="40" /><ColumnDefinition Width="48" />
      <ColumnDefinition Width="*" /><ColumnDefinition Width="64" />
     </Grid.ColumnDefinitions>
     <TextBlock Text="{x:Bind Leading}" FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold"
                TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
     <local:CoverPresenter Grid.Column="1" SourceKey="{x:Bind ImageKey}" Height="64" ImageCornerRadius="6"
                           AutomationProperties.AccessibilityView="Raw" />
     <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
      <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                 MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
      <TextBlock Text="{x:Bind Metadata}" Style="{StaticResource MetadataTextStyle}" Visibility="{x:Bind HasMetadata}"
                 TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Metadata}" />
      <ItemsControl ItemsSource="{x:Bind SiteRatings}" Visibility="{x:Bind HasSiteRatings}">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><local:TagFlowPanel HorizontalSpacing="4" VerticalSpacing="4" /></ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource ContentBrush}">
          <TextBlock Text="{Binding}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <StackPanel Grid.Column="3" VerticalAlignment="Center">
      <TextBlock Text="{x:Bind Score}" FontFamily="Bahnschrift" FontSize="22" FontWeight="SemiBold"
                 TextAlignment="Right" Foreground="{ThemeResource AccentBrush}" />
      <TextBlock Text="{x:Bind ScoreLabel}" TextAlignment="Right" Style="{StaticResource MetadataTextStyle}" />
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="NewsTemplate" x:DataType="p:DiscoveryRow">
   <Border Margin="1,0,7,10" Padding="14,12" CornerRadius="9"
           Background="{ThemeResource ContentBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1"
           AutomationProperties.Name="{x:Bind AccessibleName}" AutomationProperties.HelpText="{x:Bind Attribution}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <local:CoverPresenter SourceKey="{x:Bind ImageKey}" Visibility="{x:Bind HasImage}" Width="112" Height="68"
                           Margin="0,0,13,0" VerticalAlignment="Top" ImageCornerRadius="6"
                           AutomationProperties.AccessibilityView="Raw" />
     <StackPanel Grid.Column="1" Spacing="6">
      <TextBlock Text="{x:Bind Metadata}" Style="{StaticResource MetadataTextStyle}"
                 TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Attribution}" />
      <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                 TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
      <TextBlock Text="{x:Bind Summary}" Visibility="{x:Bind HasSummary}" Foreground="{ThemeResource TextSecondaryBrush}"
                 FontSize="13" TextWrapping="Wrap" LineHeight="21" MaxLines="3" TextTrimming="CharacterEllipsis" />
      <local:ExternalLinkButton Visibility="{x:Bind HasArticleLink}" Tag="{Binding}" Click="OnArticleLink" Margin="0,3,0,0"
                                l:Localize.Content="阅读原文" l:Localize.ToolTip="在浏览器中打开"
                                AutomationProperties.AutomationId="DiscoveryReadArticle" />
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid MaxWidth="1140">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <Grid ColumnSpacing="10" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock x:Name="Heading" Style="{StaticResource SectionTitleStyle}" FontSize="29" FontWeight="SemiBold"
              AutomationProperties.HeadingLevel="Level1" />
   <Button x:Name="ReloadButton" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}"
           Click="OnReload" l:Localize.Name="刷新" l:Localize.ToolTip="刷新" AutomationProperties.AutomationId="DiscoveryRefresh">
    <Grid Width="16" Height="16">
     <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" FontSize="15" />
     <local:LoadingMark x:Name="FeedProgress" Width="16" Height="16" Visibility="Collapsed" l:Localize.Name="正在读取…" />
    </Grid>
   </Button>
  </Grid>
  <StackPanel x:Name="RankingHeader" Grid.Row="1" Spacing="11" Visibility="Collapsed">
   <local:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="6">
   <local:SelectedFirstComboBox x:Name="RankingSourceBox" OptionIndex="0" MinWidth="120" OptionChanged="OnRankingSource"
             l:Localize.Name="评分来源" AutomationProperties.AutomationId="DiscoveryRankingSource">
    <ComboBoxItem Tag="Consensus" l:Localize.Content="综合榜" l:Localize.ToolTip="NextMoe 汇总各来源的评分。综合分采用偏差值，50 为基准。" />
    <ComboBoxItem Tag="Vndb" Content="VNDB" />
    <ComboBoxItem Tag="Bangumi" Content="Bangumi" />
    <ComboBoxItem Tag="ErogameScape" l:Localize.Content="批评空间" />
    <ComboBoxItem Tag="DLsite" Content="DLsite" />
    <ComboBoxItem Tag="HowLongToBeat" Content="HowLongToBeat" />
    <ComboBoxItem Tag="NextMoe" l:Localize.Content="NextMoe 评分" />
   </local:SelectedFirstComboBox>
   <Button x:Name="RankingFilterButton" AutomationProperties.AutomationId="DiscoveryRankingFilters">
    <StackPanel Orientation="Horizontal" Spacing="6">
     <FontIcon Glyph="&#xE71C;" FontSize="13" />
     <TextBlock x:Name="RankingFilterCaption" l:Localize.Text="筛选" />
    </StackPanel>
   </Button>
   </local:TagFlowPanel>
   <Grid ColumnSpacing="10" Margin="4,0,9,0" Padding="0,0,0,6"
         BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
    <TextBlock TextAlignment="Center" Style="{StaticResource MetadataTextStyle}" l:Localize.Text="名次" />
    <TextBlock Grid.Column="1" Style="{StaticResource MetadataTextStyle}" l:Localize.Text="作品" />
    <TextBlock Grid.Column="2" TextAlignment="Right" Style="{StaticResource MetadataTextStyle}" l:Localize.Text="评分" />
   </Grid>
  </StackPanel>
  <TextBlock x:Name="Status" Grid.Row="2" Margin="0,4,0,8" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap"
             AutomationProperties.AutomationId="DiscoveryStatus" AutomationProperties.LiveSetting="Polite" />
  <Grid x:Name="FeedBody" Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                 VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
   <ContentControl x:Name="RailHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
    <StackPanel x:Name="CalendarRail" Spacing="8">
     <Grid ColumnSpacing="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <local:SelectedFirstComboBox x:Name="CalendarWindowBox" OptionIndex="0" OptionChanged="OnCalendarWindow" HorizontalAlignment="Left"
                l:Localize.Name="月历范围" AutomationProperties.AutomationId="DiscoveryCalendarWindow">
       <ComboBoxItem l:Localize.Content="按月" />
       <ComboBoxItem l:Localize.Content="年内待定" />
       <ComboBoxItem l:Localize.Content="日期未定" />
      </local:SelectedFirstComboBox>
      <Button x:Name="TodayButton" Grid.Column="1" Click="OnToday" Style="{StaticResource SubtleButtonStyle}"
              AutomationProperties.AutomationId="DiscoveryToday" />
     </Grid>
     <Border Background="{ThemeResource ContentBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1"
             CornerRadius="10" Padding="9">
      <StackPanel Spacing="6">
       <Grid x:Name="MonthNavigator">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button x:Name="PreviousButton" Click="OnPrevious" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="DiscoveryPrevious">
         <FontIcon Glyph="&#xE76B;" FontSize="11" />
        </Button>
        <TextBlock x:Name="CalendarPeriod" Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                   TextAlignment="Center" AutomationProperties.AutomationId="DiscoveryCalendarPeriod" />
        <Button x:Name="NextButton" Grid.Column="2" Click="OnNext" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="DiscoveryNext">
         <FontIcon Glyph="&#xE76C;" FontSize="11" />
        </Button>
       </Grid>
       <Viewbox x:Name="CalendarMonthGrid" StretchDirection="DownOnly" HorizontalAlignment="Center">
        <Grid x:Name="CalendarDays" />
       </Viewbox>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="CalendarCount" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource MetadataTextStyle}" />
        <Button x:Name="CalendarAllButton" Grid.Column="1" Click="OnAllDays" Style="{StaticResource SubtleButtonStyle}"
                FontSize="12" l:Localize.Content="全部日期" />
       </Grid>
      </StackPanel>
     </Border>
    </StackPanel>
   </ContentControl>
   </ScrollViewer>
   <ListView x:Name="FeedList" Grid.Column="1" IsItemClickEnabled="True" SelectionMode="None"
             ItemClick="OnItem" ItemContainerStyle="{StaticResource FeedRow}"
             AutomationProperties.AutomationId="DiscoveryFeedList">
    <ListView.Header>
     <ContentControl x:Name="FeedHeader" Margin="1,0,7,12" HorizontalContentAlignment="Stretch" Visibility="Collapsed" />
    </ListView.Header>
    <ListView.Footer>
     <local:ScrollPageFooter x:Name="FeedPageFooter" AutomationProperties.AutomationId="DiscoveryPageFooter" />
    </ListView.Footer>
   </ListView>
   <Grid x:Name="FeedLoadingState" Grid.Column="1" IsHitTestVisible="False" Visibility="Collapsed">
    <Grid.RowDefinitions>
     <RowDefinition Height="*" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="3*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="10">
     <local:LoadingMark x:Name="FeedLoadingMark" Width="108" Height="108" HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw" />
     <TextBlock l:Localize.Text="正在读取…" Style="{StaticResource MetadataTextStyle}" HorizontalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </Grid>
  </Grid>
  <Grid x:Name="DetachedHeaders" Visibility="Collapsed">
   <StackPanel x:Name="NewsRail" Spacing="8">
    <local:SelectedFirstComboBox x:Name="NewsLaneBox" OptionIndex="0" HorizontalAlignment="Stretch" OptionChanged="OnNewsLane"
              l:Localize.Header="栏目" l:Localize.Name="资讯分类" AutomationProperties.AutomationId="DiscoveryNewsLane">
     <ComboBoxItem l:Localize.Content="全部栏目" />
     <ComboBoxItem l:Localize.Content="资讯" />
     <ComboBoxItem l:Localize.Content="专栏" />
    </local:SelectedFirstComboBox>
    <local:SelectedFirstComboBox x:Name="NewsSourceBox" OptionIndex="0" HorizontalAlignment="Stretch" OptionChanged="OnNewsSource"
              l:Localize.Header="来源" l:Localize.Name="资讯来源" AutomationProperties.AutomationId="DiscoveryNewsSource">
     <ComboBoxItem l:Localize.Content="全部来源" />
     <ComboBoxItem Content="NextMoe 用户投稿" />
     <ComboBoxItem Content="Galgame 批评" />
     <ComboBoxItem Content="月幕 Galgame" />
    </local:SelectedFirstComboBox>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
