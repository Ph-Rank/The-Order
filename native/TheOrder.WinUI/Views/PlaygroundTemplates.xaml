<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:TheOrder.WinUI.Views">
  <!-- Compiled XAML registers the pure C# message control with XamlTypeInfo.
       This dictionary is loaded only when the Playground view is requested. -->
  <DataTemplate x:Key="PlaygroundConversationTemplate">
    <Border Padding="10,0" MinHeight="34" ToolTipService.ToolTip="{Binding Tooltip}">
      <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap" MaxLines="1" VerticalAlignment="Center"
                 AutomationProperties.Name="{Binding Title}" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="PlaygroundMessageTemplate">
    <views:PlaygroundMessageView />
  </DataTemplate>
</ResourceDictionary>
