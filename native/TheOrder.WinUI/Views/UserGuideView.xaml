<UserControl
    x:Class="TheOrder.WinUI.Views.UserGuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TheOrder.WinUI.Views"
    SizeChanged="OnGuideSizeChanged">
    <UserControl.Resources>
        <CollectionViewSource x:Name="ChapterGroups" IsSourceGrouped="True" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="234" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="ChapterRail" Grid.RowSpan="2"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
            <ListView x:Name="ChapterList" ItemsSource="{x:Bind ChapterGroups.View, Mode=OneWay}"
                      Padding="24,0,16,12"
                      SelectionMode="Single" SelectionChanged="OnChapterSelected"
                      AutomationProperties.Name="帮助目录" AutomationProperties.AutomationId="UserGuideChapters">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="views:UserGuideSection">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SecondaryTextStyle}"
                                           FontSize="13" FontWeight="SemiBold" Margin="12,14,0,5"
                                           AutomationProperties.HeadingLevel="Level2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:UserGuideChapter">
                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <views:SelectedFirstComboBox x:Name="CompactChapters" Grid.Column="1" Margin="16,2,16,12"
                                     HorizontalAlignment="Stretch" MinWidth="0" Visibility="Collapsed"
                                     OptionChanged="OnCompactChapterSelected"
                                     AutomationProperties.Name="帮助目录" AutomationProperties.AutomationId="UserGuideChapterPicker" />

        <ScrollViewer x:Name="ArticleScroll" Grid.Row="1" Grid.Column="1" Padding="28,0,24,0"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="帮助正文" AutomationProperties.AutomationId="UserGuideArticleScroll">
            <StackPanel x:Name="ArticleColumn" Spacing="14" Padding="0,8,12,28"
                        HorizontalAlignment="Stretch" MaxWidth="686">
                <TextBlock x:Name="ArticleTitle" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="UserGuideArticleTitle" />
                <views:MarkdownView x:Name="ArticleBody" AutomationProperties.AutomationId="UserGuideArticle" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
