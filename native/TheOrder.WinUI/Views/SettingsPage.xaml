<?xml version="1.0" encoding="utf-8"?><Page x:Class="TheOrder.WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:TheOrder.WinUI.Localization" xmlns:p="using:TheOrder.Presentation" xmlns:views="using:TheOrder.WinUI.Views">
 <Page.Resources>
  <Style x:Key="SettingsGroupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
   <Setter Property="FontSize" Value="13" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Margin" Value="2,0,0,0" />
  </Style>
  <Style x:Key="SettingsGroupSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SurfaceStyle}">
   <Setter Property="CornerRadius" Value="12" />
   <Setter Property="Padding" Value="3" />
  </Style>
  <Style x:Key="SettingsCategoryDividerStyle" TargetType="Border">
   <Setter Property="Height" Value="1" />
   <Setter Property="Margin" Value="52,0,12,0" />
   <Setter Property="Background" Value="{ThemeResource DividerBrush}" />
  </Style>
  <Style x:Key="SettingsCategoryStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
   <Setter Property="CornerRadius" Value="8" />
   <Setter Property="MinHeight" Value="58" />
   <Setter Property="MinWidth" Value="0" />
   <Setter Property="Padding" Value="14,7" />
   <Setter Property="HorizontalAlignment" Value="Stretch" />
   <Setter Property="VerticalAlignment" Value="Stretch" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="SettingsCategoryContentStyle" TargetType="Grid">
   <Setter Property="ColumnSpacing" Value="10" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="SettingsCategoryIconStyle" TargetType="FontIcon">
   <Setter Property="FontSize" Value="22" />
   <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
   <Setter Property="HorizontalAlignment" Value="Center" />
   <Setter Property="VerticalAlignment" Value="Center" />
   <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  </Style>
  <Style x:Key="SettingsCategoryChevronStyle" TargetType="FontIcon" BasedOn="{StaticResource SettingsCategoryIconStyle}">
   <Setter Property="FontSize" Value="11" />
   <Setter Property="Glyph" Value="&#xE76C;" />
   <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
  </Style>
  <Style x:Key="SettingsCategoryOutlineStyle" TargetType="Path">
   <Setter Property="Stroke" Value="{ThemeResource TextPrimaryBrush}" />
   <Setter Property="StrokeThickness" Value="1.5" />
   <Setter Property="StrokeStartLineCap" Value="Round" />
   <Setter Property="StrokeEndLineCap" Value="Round" />
   <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
  <Style x:Key="SettingsCategoryTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
   <Setter Property="FontSize" Value="16" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="TextAlignment" Value="Left" />
  </Style>
  <Style x:Key="SettingsCategorySubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
   <Setter Property="FontSize" Value="13" />
   <Setter Property="TextAlignment" Value="Left" />
  </Style>
  <Style x:Key="SettingsOptionRowStyle" TargetType="Border" BasedOn="{StaticResource SurfaceStyle}">
   <Setter Property="Padding" Value="14,10" />
  </Style>
  <DataTemplate x:Key="MigrationRowTemplate" x:DataType="p:LibraryMigrationRow">
   <StackPanel Spacing="4" Margin="0,8" HorizontalAlignment="Stretch">
    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{x:Bind Action}" TextWrapping="Wrap" />
    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" />
    <Button x:Name="ReviewButton" x:Load="{x:Bind CanReview}" Content="核验对应与时长" Tag="{x:Bind RecordKey}" Click="OnReviewMigrationRow" />
   </StackPanel>
  </DataTemplate>
 </Page.Resources>
 <Grid x:Name="SettingsRoot" SizeChanged="OnSettingsSizeChanged">
  <ScrollViewer x:Name="SettingsOverviewScroll" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
   <Grid x:Name="SettingsOverviewColumn" Padding="24,0,24,32" MaxWidth="696" RowDefinitions="Auto,Auto"
         RowSpacing="20" HorizontalAlignment="Center" VerticalAlignment="Top">
    <Grid x:Name="SettingsHeading" ColumnSpacing="12" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
     <TextBlock Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" l:Localize.Text="设置" />
     <TextBlock x:Name="SettingsVersion" Grid.Column="1" Style="{StaticResource MetadataTextStyle}" Text="{x:Bind AppVersion}" VerticalAlignment="Center" AutomationProperties.AutomationId="AppVersion" IsTextSelectionEnabled="True" />
    </Grid>
    <StackPanel x:Name="SettingsCategories" Grid.Row="1" Spacing="22">
     <StackPanel Spacing="7">
      <TextBlock Style="{StaticResource SettingsGroupHeadingStyle}" AutomationProperties.HeadingLevel="Level2" l:Localize.Text="日常使用" />
      <Border Style="{StaticResource SettingsGroupSurfaceStyle}">
       <StackPanel>
        <Button x:Name="AppearanceCategory"
                Style="{StaticResource SettingsCategoryStyle}" Click="OnCategoryClick"
                AutomationProperties.AutomationId="SettingsAppearanceGroup" l:Localize.Name="常规">
         <Grid ColumnDefinitions="28,*,14" Style="{StaticResource SettingsCategoryContentStyle}">
          <FontIcon Style="{StaticResource SettingsCategoryIconStyle}" Glyph="&#xE790;" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
           <TextBlock Style="{StaticResource SettingsCategoryTitleStyle}" l:Localize.Text="常规" />
           <TextBlock Style="{StaticResource SettingsCategorySubtitleStyle}" l:Localize.Text="主题、语言、窗口" />
          </StackPanel>
          <FontIcon Grid.Column="2" Style="{StaticResource SettingsCategoryChevronStyle}" />
         </Grid>
        </Button>
        <Border Style="{StaticResource SettingsCategoryDividerStyle}" />
        <Button x:Name="LaunchCategory"
                Style="{StaticResource SettingsCategoryStyle}" Click="OnCategoryClick"
                AutomationProperties.AutomationId="SettingsLaunchGroup" l:Localize.Name="游玩">
         <Grid ColumnDefinitions="28,*,14" Style="{StaticResource SettingsCategoryContentStyle}">
          <FontIcon Style="{StaticResource SettingsCategoryIconStyle}" Glyph="&#xE7FC;" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
           <TextBlock Style="{StaticResource SettingsCategoryTitleStyle}" l:Localize.Text="游玩" />
           <TextBlock Style="{StaticResource SettingsCategorySubtitleStyle}" l:Localize.Text="转区、静音、攻略快捷键" />
          </StackPanel>
          <FontIcon Grid.Column="2" Style="{StaticResource SettingsCategoryChevronStyle}" />
         </Grid>
        </Button>
        <Border Style="{StaticResource SettingsCategoryDividerStyle}" />
        <Button x:Name="LibraryCategory"
                Style="{StaticResource SettingsCategoryStyle}" Click="OnCategoryClick"
                AutomationProperties.AutomationId="SettingsLibraryGroup" l:Localize.Name="书架与识别">
         <Grid ColumnDefinitions="28,*,14" Style="{StaticResource SettingsCategoryContentStyle}">
          <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
           <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SettingsCategoryOutlineStyle}"
                  Data="M 3,8 V 5 A 2,2 0 0 1 5,3 H 8 M 16,3 H 19 A 2,2 0 0 1 21,5 V 8 M 21,16 V 19 A 2,2 0 0 1 19,21 H 16 M 8,21 H 5 A 2,2 0 0 1 3,19 V 16" />
            <Path Style="{StaticResource SettingsCategoryOutlineStyle}"
                  Data="M 14.75,11.25 A 3.5,3.5 0 1 0 7.75,11.25 A 3.5,3.5 0 1 0 14.75,11.25 Z M 13.73,13.73 L 16.8,16.8" />
           </Canvas>
          </Viewbox>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
           <TextBlock Style="{StaticResource SettingsCategoryTitleStyle}" l:Localize.Text="书架与识别" />
           <TextBlock Style="{StaticResource SettingsCategorySubtitleStyle}" l:Localize.Text="导入、补全、识别" />
          </StackPanel>
          <FontIcon Grid.Column="2" Style="{StaticResource SettingsCategoryChevronStyle}" />
         </Grid>
        </Button>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Spacing="7">
      <TextBlock Style="{StaticResource SettingsGroupHeadingStyle}" AutomationProperties.HeadingLevel="Level2" l:Localize.Text="资料与维护" />
      <Border Style="{StaticResource SettingsGroupSurfaceStyle}">
       <StackPanel>
        <Button x:Name="SourcesCategory"
                Style="{StaticResource SettingsCategoryStyle}" Click="OnCategoryClick"
                AutomationProperties.AutomationId="SettingsSourcesGroup" l:Localize.Name="资料与账号">
         <Grid ColumnDefinitions="28,*,14" Style="{StaticResource SettingsCategoryContentStyle}">
          <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
           <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SettingsCategoryOutlineStyle}"
                  Data="M 4.25,4.75 H 19.75 A 2.25,2.25 0 0 1 22,7 V 17 A 2.25,2.25 0 0 1 19.75,19.25 H 4.25 A 2.25,2.25 0 0 1 2,17 V 7 A 2.25,2.25 0 0 1 4.25,4.75 Z" />
            <Path Style="{StaticResource SettingsCategoryOutlineStyle}"
                  Data="M 10,9.5 A 1.75,1.75 0 1 0 6.5,9.5 A 1.75,1.75 0 1 0 10,9.5 Z M 5.5,15.4 C 5.7,12.35 10.8,12.35 11,15.4 M 13.9,10 H 18.7 M 13.9,14 H 17.5" />
           </Canvas>
          </Viewbox>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
           <TextBlock Style="{StaticResource SettingsCategoryTitleStyle}" l:Localize.Text="资料与账号" />
           <TextBlock Style="{StaticResource SettingsCategorySubtitleStyle}" l:Localize.Text="目录、账号、同步" />
          </StackPanel>
          <FontIcon Grid.Column="2" Style="{StaticResource SettingsCategoryChevronStyle}" />
         </Grid>
        </Button>
        <Border Style="{StaticResource SettingsCategoryDividerStyle}" />
        <Button x:Name="BackupCategory"
                Style="{StaticResource SettingsCategoryStyle}" Click="OnCategoryClick"
                AutomationProperties.AutomationId="SettingsBackupGroup" l:Localize.Name="备份与存储">
         <Grid ColumnDefinitions="28,*,14" Style="{StaticResource SettingsCategoryContentStyle}">
          <FontIcon Style="{StaticResource SettingsCategoryIconStyle}" Glyph="&#xE8B7;" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
           <TextBlock Style="{StaticResource SettingsCategoryTitleStyle}" l:Localize.Text="备份与存储" />
           <TextBlock Style="{StaticResource SettingsCategorySubtitleStyle}" l:Localize.Text="备份、迁移、缓存" />
          </StackPanel>
          <FontIcon Grid.Column="2" Style="{StaticResource SettingsCategoryChevronStyle}" />
         </Grid>
        </Button>
        <Border Style="{StaticResource SettingsCategoryDividerStyle}" />
        <Button x:Name="UpdatesCategory"
                Style="{StaticResource SettingsCategoryStyle}" Click="OnCategoryClick"
                AutomationProperties.AutomationId="SettingsUpdatesGroup" l:Localize.Name="更新与反馈">
         <Grid ColumnDefinitions="28,*,14" Style="{StaticResource SettingsCategoryContentStyle}">
          <FontIcon Style="{StaticResource SettingsCategoryIconStyle}" Glyph="&#xE895;" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
           <TextBlock Style="{StaticResource SettingsCategoryTitleStyle}" l:Localize.Text="更新与反馈" />
           <TextBlock Style="{StaticResource SettingsCategorySubtitleStyle}" l:Localize.Text="版本、通道、问题反馈" />
          </StackPanel>
          <FontIcon Grid.Column="2" Style="{StaticResource SettingsCategoryChevronStyle}" />
         </Grid>
        </Button>
        <Border Style="{StaticResource SettingsCategoryDividerStyle}" />
        <Button x:Name="HelpCategory"
                Style="{StaticResource SettingsCategoryStyle}" Click="OnCategoryClick"
                AutomationProperties.AutomationId="OpenUserGuide" l:Localize.Name="使用帮助">
         <Grid ColumnDefinitions="28,*,14" Style="{StaticResource SettingsCategoryContentStyle}">
          <FontIcon Style="{StaticResource SettingsCategoryIconStyle}" Glyph="&#xE897;" />
          <TextBlock Grid.Column="1" Style="{StaticResource SettingsCategoryTitleStyle}"
                     VerticalAlignment="Center" l:Localize.Text="使用帮助" />
          <FontIcon Grid.Column="2" Style="{StaticResource SettingsCategoryChevronStyle}" />
         </Grid>
        </Button>
       </StackPanel>
      </Border>
     </StackPanel>
    </StackPanel>
   </Grid>
  </ScrollViewer>

  <Grid x:Name="SettingsDetail" RowDefinitions="Auto,*" Visibility="Collapsed">
   <StackPanel x:Name="SettingsDetailHeading" Padding="24,0,24,12" Spacing="8" HorizontalAlignment="Center">
    <Button x:Name="SettingsBack" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0"
            HorizontalAlignment="Left" Click="OnSettingsBack" AutomationProperties.AutomationId="SettingsBack" l:Localize.Name="返回">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <FontIcon FontSize="14" Glyph="&#xE72B;" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock l:Localize.Text="设置" />
     </StackPanel>
    </Button>
    <TextBlock x:Name="SettingsCategoryTitle" Style="{StaticResource PageTitleStyle}"
               AutomationProperties.AutomationId="SettingsCategoryTitle" AutomationProperties.HeadingLevel="Level1" />
   </StackPanel>
   <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
    <StackPanel x:Name="SettingsColumn" Padding="24,8,24,32" MaxWidth="756" HorizontalAlignment="Center" VerticalAlignment="Top">
     <StackPanel x:Name="AppearancePanel" Spacing="24" Visibility="Collapsed">
      <StackPanel Spacing="10">
       <TextBlock Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" l:Localize.Text="外观" />
        <Border Style="{StaticResource SettingsOptionRowStyle}">
         <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
          <TextBlock l:Localize.Text="外观主题" VerticalAlignment="Center" TextWrapping="Wrap" />
          <views:SelectedFirstComboBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="ThemeChoice" OptionChanged="OnAppearance" AutomationProperties.AutomationId="ThemeChoice" l:Localize.Name="外观主题"><ComboBoxItem l:Localize.Content="跟随系统" /><ComboBoxItem l:Localize.Content="浅色" /><ComboBoxItem l:Localize.Content="深色" /></views:SelectedFirstComboBox>
         </Grid>
        </Border>
        <Border Style="{StaticResource SettingsOptionRowStyle}">
         <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
          <TextBlock l:Localize.Text="材质效果" VerticalAlignment="Center" TextWrapping="Wrap" />
          <views:SelectedFirstComboBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="MaterialChoice" OptionChanged="OnMaterialMode" AutomationProperties.AutomationId="MaterialChoice" l:Localize.Name="材质效果"><ComboBoxItem l:Localize.Content="自动" /><ComboBoxItem l:Localize.Content="日常玻璃" /><ComboBoxItem l:Localize.Content="标准" /></views:SelectedFirstComboBox>
         </Grid>
        </Border>
        <TextBlock x:Name="MaterialError" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource WarningTextBrush}" AutomationProperties.LiveSetting="Polite" />
        <Border Style="{StaticResource SettingsOptionRowStyle}">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock l:Localize.Text="显示对话入口" VerticalAlignment="Center" TextWrapping="Wrap" />
          <CheckBox Grid.Column="1" x:Name="PlaygroundEntryChoice" MinWidth="0" IsChecked="True" Click="OnPlaygroundEntry"
                    l:Localize.Name="显示对话入口" AutomationProperties.AutomationId="ShowPlaygroundNavigation" />
         </Grid>
        </Border>
        <TextBlock x:Name="PlaygroundEntryNotice" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <StackPanel Spacing="10">
       <TextBlock Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" l:Localize.Text="语言" />
        <StackPanel x:Name="LanguageOptions" Spacing="10" Visibility="Collapsed">
         <Border Style="{StaticResource SettingsOptionRowStyle}">
          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
           <TextBlock l:Localize.Text="界面语言" VerticalAlignment="Center" TextWrapping="Wrap" />
           <views:SelectedFirstComboBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="LanguageChoice" OptionChanged="OnLanguage" AutomationProperties.AutomationId="LanguageChoice" l:Localize.Name="界面语言"><ComboBoxItem l:Localize.Content="跟随系统" /><ComboBoxItem l:Localize.Content="简体中文" /><ComboBoxItem l:Localize.Content="繁體中文" /><ComboBoxItem l:Localize.Content="日本語" /><ComboBoxItem Content="English" /></views:SelectedFirstComboBox>
          </Grid>
         </Border>
         <TextBlock Text="{x:Bind Languages.Message, Mode=OneWay}" Visibility="{x:Bind VisibleText(Languages.Message), Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="LanguageState" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel Spacing="10">
         <Border Style="{StaticResource SettingsOptionRowStyle}">
          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
           <TextBlock l:Localize.Text="资料首选语言" VerticalAlignment="Center" TextWrapping="Wrap" />
           <views:SelectedFirstComboBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="ContentLanguageChoice" OptionChanged="OnContentLanguage" IsEnabled="{x:Bind ContentLanguages.CanChange, Mode=OneWay}" AutomationProperties.AutomationId="ContentLanguageChoice" l:Localize.Name="资料首选语言"><ComboBoxItem Content="简体中文" /><ComboBoxItem Content="繁體中文" /><ComboBoxItem Content="日本語" /><ComboBoxItem Content="English" /><ComboBoxItem Content="原文" /></views:SelectedFirstComboBox>
          </Grid>
         </Border>
         <Border Style="{StaticResource SettingsOptionRowStyle}">
          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
           <TextBlock l:Localize.Text="缺少译文时优先使用" VerticalAlignment="Center" TextWrapping="Wrap" />
           <views:SelectedFirstComboBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="ContentFallbackChoice" OptionChanged="OnContentLanguage" IsEnabled="{x:Bind ContentLanguages.CanChange, Mode=OneWay}" AutomationProperties.AutomationId="ContentFallbackChoice" l:Localize.Name="缺少译文时优先使用"><ComboBoxItem Content="简体中文" /><ComboBoxItem Content="繁體中文" /><ComboBoxItem Content="日本語" /><ComboBoxItem Content="English" /><ComboBoxItem Content="原文" /></views:SelectedFirstComboBox>
          </Grid>
         </Border>
         <TextBlock Text="{x:Bind ContentLanguages.Message, Mode=OneWay}" Visibility="{x:Bind VisibleText(ContentLanguages.Message), Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ContentLanguageState" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="WindowAndTraySection" Spacing="10">
       <TextBlock Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" l:Localize.Text="窗口与托盘" />
       <Border Style="{StaticResource SettingsOptionRowStyle}">
        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
         <TextBlock Text="关闭窗口时" VerticalAlignment="Center" TextWrapping="Wrap" />
         <views:SelectedFirstComboBox Grid.Column="1" x:Name="CloseActionChoice" MinWidth="0" HorizontalAlignment="Stretch"
                   IsEnabled="False" OptionIndex="0" OptionChanged="OnCloseActionChanged"
                   AutomationProperties.AutomationId="WindowCloseAction" AutomationProperties.Name="关闭窗口时">
          <ComboBoxItem Content="收起到托盘" />
          <ComboBoxItem Content="退出程序" />
         </views:SelectedFirstComboBox>
        </Grid>
       </Border>
       <TextBlock x:Name="CloseActionStatus" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                  Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="LaunchPanel" Spacing="20" Visibility="Collapsed">
       <StackPanel x:Name="LaunchDefaultsSection" Spacing="16" AutomationProperties.AutomationId="GlobalLaunchSettings">
        <TextBlock Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" l:Localize.Text="启动" />
        <StackPanel Spacing="8">
         <Border Style="{StaticResource SettingsOptionRowStyle}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
           <TextBlock l:Localize.Text="Locale Emulator · 日文转区" VerticalAlignment="Center" TextWrapping="Wrap" />
           <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" l:Localize.Name="Locale Emulator · 日文转区" IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" IsOn="{x:Bind LaunchDefaults.LocaleEmulatorEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="GlobalLocaleEnabled" />
          </Grid>
         </Border>
         <views:SmoothExpander x:Name="GlobalLocaleToolSection" Header="Locale Emulator 工具位置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="GlobalLocaleToolSection"><StackPanel Spacing="8">
         <TextBox IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Header="LEProc.exe 路径" PlaceholderText="选择已安装的 Locale Emulator" Text="{x:Bind LaunchDefaults.LocaleEmulatorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="32768" AutomationProperties.AutomationId="GlobalLocalePath" />
         <Button IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Content="选择 LEProc.exe" Click="OnChooseGlobalLocale" HorizontalAlignment="Left" />
         </StackPanel></views:SmoothExpander>
        </StackPanel>
        <StackPanel Spacing="8">
         <Border Style="{StaticResource SettingsOptionRowStyle}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
           <TextBlock l:Localize.Text="Magpie · 窗口缩放" VerticalAlignment="Center" TextWrapping="Wrap" />
           <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" l:Localize.Name="Magpie · 窗口缩放" IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" IsOn="{x:Bind LaunchDefaults.MagpieEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="GlobalMagpieEnabled" />
          </Grid>
         </Border>
         <views:SmoothExpander x:Name="GlobalMagpieToolSection" Header="Magpie 工具位置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="GlobalMagpieToolSection"><StackPanel Spacing="8">
         <TextBox IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Header="Magpie.exe 路径" PlaceholderText="选择已安装的 Magpie" Text="{x:Bind LaunchDefaults.MagpiePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="32768" AutomationProperties.AutomationId="GlobalMagpiePath" />
         <Button IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Content="选择 Magpie.exe" Click="OnChooseGlobalMagpie" HorizontalAlignment="Left" />
         </StackPanel></views:SmoothExpander>
        </StackPanel>
        <TextBlock Margin="0,6,0,0" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" l:Localize.Text="游戏中" />
        <Border Style="{StaticResource SettingsOptionRowStyle}">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="后台静音" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ToggleSwitch Grid.Column="1" MinWidth="0" IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}"
                        IsOn="{x:Bind LaunchDefaults.BackgroundMuteEnabled, Mode=TwoWay}" OnContent="" OffContent=""
                        AutomationProperties.AutomationId="GlobalMuteEnabled" AutomationProperties.Name="后台静音"
                        ToolTipService.ToolTip="仅影响正在计时的游戏，切回游戏时恢复原静音状态。" />
         </Grid>
        </Border>
        <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8" Visibility="{x:Bind Visible(LaunchDefaults.HasChanges), Mode=OneWay}">
         <Button Content="保存启动设置" Click="OnSaveLaunchDefaults" IsEnabled="{x:Bind LaunchDefaults.CanSave, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveGlobalLaunch" />
         <Button Content="放弃修改" Click="OnCancelLaunchDefaults" IsEnabled="{x:Bind LaunchDefaults.CanSave, Mode=OneWay}" AutomationProperties.AutomationId="CancelGlobalLaunch" />
        </views:TagFlowPanel>
        <TextBlock Text="{x:Bind LaunchDefaults.Message, Mode=OneWay}" Visibility="{x:Bind VisibleText(LaunchDefaults.Message), Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="GlobalLaunchState" />
       </StackPanel>
       <Border x:Name="GameAssistantSection" Style="{StaticResource SettingsOptionRowStyle}">
        <StackPanel Spacing="8">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="游戏内助手" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ToggleSwitch Grid.Column="1" x:Name="GuideEnabledChoice" MinWidth="0" OnContent="" OffContent=""
                        IsEnabled="False" Toggled="OnGuideEnabledChanged"
                        AutomationProperties.AutomationId="GameAssistantEnabled" AutomationProperties.Name="游戏内助手" />
         </Grid>
         <Border Height="1" Background="{ThemeResource DividerBrush}" />
         <ContentControl x:Name="GuideShortcutHost" HorizontalContentAlignment="Stretch" />
        </StackPanel>
       </Border>
     </StackPanel>
     <StackPanel x:Name="SourcesPanel" Spacing="20" Visibility="Collapsed">
       <StackPanel x:Name="NextMoeSection" Spacing="12">
        <TextBlock FontSize="16" FontWeight="SemiBold" l:Localize.Text="在线目录 · NextMoe" />
        <Border Style="{StaticResource SettingsOptionRowStyle}">
         <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
          <TextBlock l:Localize.Text="访问方式" VerticalAlignment="Center" TextWrapping="Wrap" />
