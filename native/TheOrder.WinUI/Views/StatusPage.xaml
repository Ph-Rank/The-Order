<Page x:Class="TheOrder.WinUI.Views.StatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      AutomationProperties.AutomationId="StatusPage">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
  <StackPanel MaxWidth="1100" Margin="24,0,24,32" Spacing="16">
   <TextBlock Text="状态" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
   <Border Style="{StaticResource SurfaceStyle}" Padding="18" CornerRadius="12">
    <StackPanel Spacing="12">
     <TextBlock Text="后台任务" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
     <TextBlock x:Name="EmptyTasks" Text="暂无后台任务" Style="{StaticResource SecondaryTextStyle}" />
     <StackPanel x:Name="Tasks" Spacing="12" AutomationProperties.AutomationId="StatusTasks" />
    </StackPanel>
   </Border>
   <Border Style="{StaticResource SurfaceStyle}" Padding="18" CornerRadius="12">
    <StackPanel Spacing="12">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="运行消息" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
      <Button x:Name="ClearMessages" Grid.Column="1" Content="清空记录" Click="OnClearMessages"
              Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="ClearStatusMessages" />
     </Grid>
     <TextBlock x:Name="EmptyMessages" Text="暂无运行消息" Style="{StaticResource SecondaryTextStyle}" />
     <StackPanel x:Name="Messages" Spacing="8" AutomationProperties.AutomationId="StatusMessages" />
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Page>
