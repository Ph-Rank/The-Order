<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TheOrder.WinUI.Views.OnlinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:p="using:TheOrder.Presentation" xmlns:local="using:TheOrder.WinUI.Views"
      xmlns:l="using:TheOrder.WinUI.Localization">
 <Page.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="DiscoverySearchFill" Color="#FFFFFF" />
     <SolidColorBrush x:Key="DiscoverySearchStroke" Color="#CFD5DF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="DiscoverySearchFill" Color="#2A2E39" />
     <SolidColorBrush x:Key="DiscoverySearchStroke" Color="#4B5262" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="DiscoverySearchFill" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="DiscoverySearchStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="OnlineCardStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
   </Style>
   <Style x:Key="DiscoverySearchButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
   </Style>
  </ResourceDictionary>
 </Page.Resources>
 <Grid x:Name="OnlineRoot" Padding="24,0,24,24">
  <Grid x:Name="DiscoveryHome" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <SelectorBar x:Name="DiscoveryTabs" HorizontalAlignment="Center" SelectionChanged="OnDiscoverySection"
                AutomationProperties.AutomationId="DiscoveryTabs" l:Localize.Name="发现分类">
    <SelectorBar.Resources>
     <SolidColorBrush x:Key="SelectorBarItemForeground" Color="{ThemeResource TextFillColorSecondary}" />
     <SolidColorBrush x:Key="SelectorBarItemForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
     <SolidColorBrush x:Key="SelectorBarItemForegroundPressed" Color="{ThemeResource TextFillColorPrimary}" />
    </SelectorBar.Resources>
    <SelectorBarItem x:Name="SearchTab" l:Localize.Text="搜索" AutomationProperties.AutomationId="DiscoverySearchTab" />
    <SelectorBarItem x:Name="CalendarTab" l:Localize.Text="发售月历" AutomationProperties.AutomationId="DiscoveryCalendarTab" />
    <SelectorBarItem x:Name="RankingsTab" l:Localize.Text="评分榜" AutomationProperties.AutomationId="DiscoveryRankingsTab" />
    <SelectorBarItem x:Name="NewsTab" l:Localize.Text="Galgame 资讯" AutomationProperties.AutomationId="DiscoveryNewsTab" />
   </SelectorBar>
  <Grid x:Name="SearchResults" Grid.Row="1">
   <Grid.RowDefinitions>
    <RowDefinition x:Name="SearchLandingSpacer" Height="0" MaxHeight="144" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="16" />
    <RowDefinition Height="3*" />
   </Grid.RowDefinitions>
   <StackPanel x:Name="SearchHeader" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="612">
    <TextBlock x:Name="DiscoveryTitle" Style="{StaticResource PageTitleStyle}" FontSize="32"
               TextAlignment="Center" Margin="0,0,0,16" AutomationProperties.HeadingLevel="Level1"
               l:Localize.Text="发现作品" />
    <Grid MinHeight="50">
     <Border Background="{ThemeResource DiscoverySearchFill}" BorderBrush="{ThemeResource DiscoverySearchStroke}"
             BorderThickness="1" CornerRadius="25" Tapped="OnSearchSurfaceTapped" />
     <Border x:Name="SearchFocusOutline" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2"
             CornerRadius="25" IsHitTestVisible="False" Visibility="Collapsed" />
     <Grid ColumnSpacing="7" Margin="17,4,6,4">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="18" />
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon x:Name="SearchGlyph" Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}"
                IsHitTestVisible="False" />
      <local:LoadingMark x:Name="SearchInlineMark" Width="16" Height="16" Visibility="Collapsed" l:Localize.Name="正在搜索作品" />
      <TextBox x:Name="OnlineQueryBox" Grid.Column="1" MinWidth="0" MinHeight="36" Padding="2,6,2,6"
               Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False"
               Foreground="{ThemeResource TextPrimaryBrush}" PlaceholderForeground="{ThemeResource TextSecondaryBrush}"
               VerticalAlignment="Center" FontSize="15"
               Text="{x:Bind ViewModel.Query, Mode=OneWay}" KeyDown="OnQueryKeyDown" TextChanged="OnQueryTextChanged"
               GotFocus="OnSearchFocusChanged" LostFocus="OnSearchFocusChanged"
               AutomationProperties.AutomationId="OnlineQuery"
               l:Localize.PlaceholderText="搜索作品名、#编号或作品链接" l:Localize.Name="搜索在线作品目录，回车搜索">
       <TextBox.Resources>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
       </TextBox.Resources>
      </TextBox>
      <Button x:Name="SearchButton" Grid.Column="2" Click="OnSearch" Style="{StaticResource DiscoverySearchButton}"
              Visibility="{x:Bind IdleVisibility(ViewModel.SearchLoading), Mode=OneWay}"
              IsEnabled="False"
              AutomationProperties.AutomationId="OnlineSearch" l:Localize.Name="搜索" ToolTipService.ToolTip="搜索">
       <FontIcon Glyph="&#xE72A;" FontSize="16" />
      </Button>
      <Button Grid.Column="2" Click="OnCancel" Style="{StaticResource DiscoverySearchButton}"
              Visibility="{x:Bind BusyVisibility(ViewModel.SearchLoading), Mode=OneWay}"
              AutomationProperties.AutomationId="OnlineCancel" l:Localize.Name="取消搜索" ToolTipService.ToolTip="取消搜索">
       <FontIcon Glyph="&#xE711;" FontSize="13" />
      </Button>
     </Grid>
    </Grid>
    <TextBlock x:Name="SearchStatus" Text="{x:Bind ViewModel.SearchMessage, Mode=OneWay}"
               Visibility="Collapsed"
               Margin="2,10,2,0" TextWrapping="Wrap" Style="{StaticResource MetadataTextStyle}"
               AutomationProperties.AutomationId="OnlineSearchMessage" AutomationProperties.LiveSetting="Polite" />
   </StackPanel>
   <Grid x:Name="SearchResultBody" Grid.Row="3">
   <GridView x:Name="ResultsGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnWork" ItemContainerStyle="{StaticResource OnlineCardStyle}" SizeChanged="OnResultsSizeChanged" AutomationProperties.AutomationId="OnlineResults" l:Localize.Name="作品封面网格">
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" Loaded="OnWrapLoaded" /></ItemsPanelTemplate></GridView.ItemsPanel>
    <GridView.ItemTemplate>
     <DataTemplate x:DataType="p:OnlineCard">
      <Grid Margin="8,8,8,16" RowSpacing="8" AutomationProperties.Name="{x:Bind Title}">
       <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="74" /></Grid.RowDefinitions>
       <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1"><local:CoverPresenter SourceKey="{x:Bind CoverKey}" ImageCornerRadius="7" /></Border>
       <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock Text="{x:Bind Title}" TextAlignment="Center" HorizontalAlignment="Stretch" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
        <Grid ColumnSpacing="4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <TextBlock Text="{x:Bind Subtitle}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Subtitle}" />
         <Button Grid.Column="1" Content="{x:Bind CatalogNumber}" Tag="{x:Bind Id}" Click="OnCopyNumber" Padding="5,2" MinWidth="0" MinHeight="24" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextSecondaryBrush}" ToolTipService.ToolTip="复制目录编号，用于手动关联" AutomationProperties.Name="{x:Bind CatalogNumber}" AutomationProperties.HelpText="复制目录编号" AutomationProperties.AutomationId="OnlineCopyNumber" />
        </Grid>
       </StackPanel>
      </Grid>
     </DataTemplate>
    </GridView.ItemTemplate>
    <GridView.Footer><local:ScrollPageFooter x:Name="SearchPageFooter" AutomationProperties.AutomationId="OnlinePageFooter" /></GridView.Footer>
   </GridView>
    <Grid x:Name="SearchLoadingState" IsHitTestVisible="False" Visibility="Collapsed">
     <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" />
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="10">
      <local:LoadingMark x:Name="SearchLoadingMark" Width="108" Height="108" HorizontalAlignment="Center"
                         AutomationProperties.AccessibilityView="Raw" />
      <TextBlock l:Localize.Text="正在搜索在线目录…" Style="{StaticResource MetadataTextStyle}"
                 HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
     </StackPanel>
    </Grid>
   </Grid>
  </Grid>
    <ContentControl x:Name="DiscoveryFeedHost" Grid.Row="1" Visibility="Collapsed"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
  <ContentControl x:Name="BrowserHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
 </Grid>
</Page>
