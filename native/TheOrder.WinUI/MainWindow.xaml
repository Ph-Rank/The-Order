<?xml version="1.0" encoding="utf-8"?><Window x:Class="TheOrder.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="The Order" xmlns:l="using:TheOrder.WinUI.Localization">
 <Grid x:Name="Root" SizeChanged="OnShellSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <!-- Solid canvas replaces Mica when transparency is off (system, app setting, HC or policy fault). -->
  <Border x:Name="OpaqueCanvas" Grid.RowSpan="3" Background="{ThemeResource CanvasBrush}" />
  <!-- Page navigation and runtime status live below the window caption. -->
  <TitleBar x:Name="AppTitleBar" Title="The Order" IsBackButtonVisible="False" IsBackButtonEnabled="False" IsPaneToggleButtonVisible="False" BackRequested="OnTitleBack" PaneToggleRequested="OnPaneToggle" AutomationProperties.AutomationId="AppTitleBar">
   <TitleBar.Resources>
    <!-- Keep the window caption aligned with the system buttons. -->
    <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
   </TitleBar.Resources>
   <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/Brand.Light.png" /></TitleBar.IconSource>
  </TitleBar>
  <Grid x:Name="WorkspaceSurface" Grid.Row="1" Opacity="0">
   <NavigationView x:Name="Navigation" xmlns:views="using:TheOrder.WinUI.Views" IsHitTestVisible="False" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="72" CompactPaneLength="72" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" ItemInvoked="OnNavigationInvoked" DisplayModeChanged="OnNavigationDisplayModeChanged">
    <NavigationView.Resources>
     <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
       <!-- The built-in ContentGrid otherwise paints a second gray slab over Mica. -->
       <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" /></ResourceDictionary>
       <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" /></ResourceDictionary>
       <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" /></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
     </ResourceDictionary>
    </NavigationView.Resources>
    <NavigationView.MenuItems>
     <views:RailNavigationItem x:Name="LibraryNavigation" Tag="library" HorizontalContentAlignment="Stretch" Padding="0" Height="74" AutomationProperties.AutomationId="LibraryNavigation" l:Localize.Name="书架"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="" FontSize="23" HorizontalAlignment="Center" /><TextBlock FontSize="12" HorizontalAlignment="Center" l:Localize.Text="书架" /></StackPanel></views:RailNavigationItem>
     <views:RailNavigationItem x:Name="OnlineNavigation" Tag="online" HorizontalContentAlignment="Stretch" Padding="0" Height="74" AutomationProperties.AutomationId="OnlineNavigation" l:Localize.Name="发现"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="" FontSize="23" HorizontalAlignment="Center" /><TextBlock FontSize="12" HorizontalAlignment="Center" l:Localize.Text="发现" /></StackPanel></views:RailNavigationItem>
     <views:RailNavigationItem x:Name="StatisticsNavigation" Tag="statistics" HorizontalContentAlignment="Stretch" Padding="0" Height="74" AutomationProperties.AutomationId="StatisticsNavigation" l:Localize.Name="统计"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="&#xE9D9;" FontSize="23" HorizontalAlignment="Center" /><TextBlock FontSize="12" HorizontalAlignment="Center" l:Localize.Text="统计" /></StackPanel></views:RailNavigationItem>
     <views:RailNavigationItem x:Name="PlaygroundNavigation" Tag="playground" HorizontalContentAlignment="Stretch" Padding="0" Height="74" AutomationProperties.AutomationId="PlaygroundNavigation" AutomationProperties.Name="对话">
      <StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="&#xE8F2;" FontSize="23" HorizontalAlignment="Center" /><TextBlock FontSize="11" HorizontalAlignment="Center" Text="对话" /></StackPanel>
      <views:RailNavigationItem.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="隐藏对话入口" Click="OnHidePlayground" /></MenuFlyout></views:RailNavigationItem.ContextFlyout>
     </views:RailNavigationItem>
    </NavigationView.MenuItems>
    <NavigationView.FooterMenuItems>
     <views:RailNavigationItem x:Name="StatusNavigation" Tag="status" HorizontalContentAlignment="Stretch" Padding="0" Height="74"
                               AutomationProperties.AutomationId="StatusNavigation" AutomationProperties.Name="状态">
      <StackPanel Spacing="6" HorizontalAlignment="Center">
       <Grid Width="34" Height="28">
        <FontIcon Glyph="&#xE7BA;" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse x:Name="StatusBadge" Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
                 AutomationProperties.AccessibilityView="Raw" />
       </Grid>
       <TextBlock FontSize="12" HorizontalAlignment="Center" Text="状态" />
      </StackPanel>
     </views:RailNavigationItem>
     <views:RailNavigationItem x:Name="SettingsNavigation" Tag="settings" HorizontalContentAlignment="Stretch" Padding="0" Height="74" AutomationProperties.AutomationId="SettingsNavigation" l:Localize.Name="设置"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="" FontSize="23" HorizontalAlignment="Center" /><TextBlock FontSize="12" HorizontalAlignment="Center" l:Localize.Text="设置" /></StackPanel></views:RailNavigationItem>
    </NavigationView.FooterMenuItems>
    <!-- Transparent page content shares the shell backdrop; high contrast keeps its system surface. -->
    <Grid x:Name="ContentLayer" Padding="0,24,0,0" Background="{ThemeResource LayerBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <!-- Back aligns to the content's left edge, immediately beside the rail. -->
     <Grid x:Name="PageNavigationToolbar" Margin="24,0,24,8" Visibility="Collapsed">
      <Button x:Name="RailBack" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="OnRailBack" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="GoBack" l:Localize.Name="返回上一页" ToolTipService.ToolTip="返回上一页"><FontIcon Glyph="" FontSize="18" /></Button>
     </Grid>
     <ContentControl x:Name="PageContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
    </Grid>
   </NavigationView>
   <Border x:Name="RailIndicator" Width="3" Height="16" CornerRadius="1.5"
           Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
           Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" IsHitTestVisible="False"
           AutomationProperties.AccessibilityView="Raw" />
  </Grid>
  <Grid x:Name="DialogLayer" Grid.Row="1" Background="{ThemeResource ContentDialogSmokeFill}" Visibility="Collapsed" />
  <Grid x:Name="StartupSurface" Grid.Row="1" Background="Transparent" AutomationProperties.AutomationId="StartupLoadingPage">
   <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" MaxHeight="368" Margin="24">
    <Grid.RowDefinitions>
     <RowDefinition Height="*" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Grid x:Name="StartupLogoStage" Width="312" Height="312">
      <Image x:Name="StartupLogo" ImageOpened="OnStartupLogoOpened" AutomationProperties.Name="The Order" />
     </Grid>
    </Viewbox>
    <ProgressRing x:Name="StartupRing" Grid.Row="1" Width="28" Height="28" Margin="0,28,0,0"
                  HorizontalAlignment="Center" IsActive="True" RenderTransformOrigin=".5,.5"
                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" AutomationProperties.Name="正在加载书架">
     <ProgressRing.RenderTransform><RotateTransform /></ProgressRing.RenderTransform>
     <ProgressRing.Template>
      <ControlTemplate TargetType="ProgressRing">
       <Path Data="M 3,14 A 11,11 0 0 1 14,3" Stretch="None" Stroke="{TemplateBinding Foreground}"
             StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </ControlTemplate>
     </ProgressRing.Template>
    </ProgressRing>
    <TextBlock x:Name="StartupError" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed" TextWrapping="Wrap"
               TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    <Button x:Name="StartupExit" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed" HorizontalAlignment="Center"
            Content="退出" Click="OnStartupExit" />
   </Grid>
  </Grid>
  <!-- Test diagnostics only. Receipts keep reading RuntimeState; Ctrl+Shift+D toggles visibility in diagnostics builds. -->
  <StackPanel x:Name="DiagnosticsPanel" Grid.Row="2" Visibility="Collapsed">
   <StackPanel x:Name="RecognitionBoundaryControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><Button Click="OnDelayCandidate" l:Localize.Content="延迟候选 200" /><Button Click="OnReleaseCandidate" l:Localize.Content="候选放行" /><Button Click="OnSyntheticAuthChange" l:Localize.Content="模拟凭据变化" /></StackPanel>
   <StackPanel x:Name="SyntheticControls" Orientation="Horizontal" Spacing="8"><TextBlock l:Localize.Text="合成验收控制" /><Button Click="OnDelayDetails" l:Localize.Content="延迟详情" /><Button Click="OnFailRefresh" l:Localize.Content="刷新故障" /><Button Click="OnDelayBatch" l:Localize.Content="延迟批量" /><Button Click="OnFailReload" l:Localize.Content="重读故障" /><Button Click="OnRelease" l:Localize.Content="放行" /><Button Click="OnCancelOperation" l:Localize.Content="取消操作" /><Button Click="OnDelayQuery" l:Localize.Content="延迟搜索" /><Button Click="OnDelayScan" l:Localize.Content="延迟扫描" /></StackPanel>
   <TextBlock x:Name="RuntimeState" TextTrimming="CharacterEllipsis" MaxHeight="18" FontSize="10" AutomationProperties.AutomationId="RuntimeEvidence" />
  </StackPanel>
 </Grid>
</Window>
